# Skopiuj do .env i uzupelnij. .env NIGDY nie trafia do repo.
# Na etapie budowy uzywamy wylacznie kont testowych/sandbox.

# --- Aplikacja ---
APP_ENV=development
API_PORT=8080
PUBLIC_API_URL=http://localhost:8080

# --- Baza danych (docker compose up db) ---
DATABASE_URL=postgres://doyousend:doyousend@localhost:5432/doyousend?sslmode=disable
# Testy integracyjne (make test-integration). Kazdy test tworzy i usuwa wlasny schemat,
# wiec moze to byc ta sama baza co DATABASE_URL.
TEST_DATABASE_URL=postgres://doyousend:doyousend@localhost:5432/doyousend?sslmode=disable

# --- Kolejka / worker ---
REDIS_URL=redis://localhost:6379/0

# --- Logowanie (ADR-0010) ---
# Sesje po stronie serwera w tabeli sessions; cookie dys_session (HttpOnly, SameSite=Lax).
# Secure (tylko HTTPS) jest domyslnie wlaczone poza APP_ENV=development.
SESSION_COOKIE_SECURE=false
# Haslo pierwszego administratora dla `make create-admin` (min. 12 znakow). Mozna zostawic
# puste - wtedy komenda zapyta o nie. Nie commituj prawdziwego hasla.
ADMIN_PASSWORD=

# --- Dostawca e-mail ---
# Lokalnie: Mailpit (docker compose), bez uwierzytelniania, nic nie wychodzi na zewnatrz.
# Produkcyjnie / integracyjnie: SendGrid Web API v3 (EMAIL_PROVIDER=sendgrid; ADR-0008).
EMAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Szkola Testowa <no-reply@example.test>"
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
SENDGRID_SANDBOX=false
# Region danych SendGrid: global (api.sendgrid.com) albo eu (api.eu.sendgrid.com). ADR-0014.
# Prawdopodobnie klucz musi pochodzic z konta w tym samym regionie (do potwierdzenia w SendGrid).
SENDGRID_REGION=global
# Weryfikacja nadawcow (Single Sender Verification, ADR-0016): adres szkoly pokazywany
# w e-mailu z linkiem potwierdzajacym. Klucz API potrzebuje uprawnienia "Sender Verification".
# Przy DRY_RUN=true albo EMAIL_PROVIDER!=sendgrid nic nie jest wysylane (atrapa w pamieci).
SENDGRID_SENDER_ADDRESS="ul. Przykladowa 1"
SENDGRID_SENDER_CITY=Testowo
SENDGRID_SENDER_ZIP=00-000
SENDGRID_SENDER_COUNTRY=Polska

# --- Bramka SMS ---
# Lokalnie: provider "fake" zapisuje SMS-y do logu/bazy zamiast wysylac.
# Produkcyjnie: provider "smsapi" wysyla przez REST API SMSAPI (ADR-0003).
SMS_PROVIDER=fake
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NAME=SZKOLA-TEST
SMS_TEST_MODE=false
SMS_PRICE_PER_PART_PLN=0.08
# Sekretny token callbacku DLR z SMSAPI (np. /providers/sms/dlr?token=... lub /providers/sms/dlr/{token}).
# Uwaga: token w URL moze trafic do access logow proxy/serwera - rotuj w przypadku wycieku logow.
SMSAPI_DLR_TOKEN=

# --- Import odbiorcow z Notion (ADR-0017, make import-notion) ---
# Sekret integracji wewnetrznej (Notion > Settings > Connections > Develop or manage integrations).
# Baze trzeba udostepnic integracji: "..." > Connections > dodaj integracje.
NOTION_TOKEN=
# ID albo caly URL bazy. Gdy baza ma kilka zrodel danych, podaj NOTION_DATA_SOURCE_ID.
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=
# Opcjonalnie: "Kolumna w Notion=kolumna importu", np. "Name=first_name,Surname=last_name".
# Puste = kolumny w Notion nazwane jak w szablonie CSV (Imię, Nazwisko, E-mail, Telefon, Typ, Klasa).
NOTION_PROPERTY_MAP=

# --- Bezpiecznik wysylki ---
# true = system nie wysyla nic na zewnatrz, tylko rejestruje.
DRY_RUN=true
# true = panel administratora nie moze wylaczyc DRY_RUN (srodowiska demo i testowe). ADR-0018.
DRY_RUN_LOCK=false

# --- Ustawienia z panelu (ADR-0018) ---
# Wartosci zapisane w panelu (Panel administratora -> Ustawienia wysylki) wygrywaja z tym plikiem.
# Klucze API z panelu sa szyfrowane w bazie tym kluczem (32 losowe bajty w base64, np.
# `openssl rand -base64 32`). Gdy pusty, API tworzy plik SETTINGS_KEY_FILE przy pierwszym starcie.
# Zrob kopie klucza/pliku: bez niego klucze API trzeba wpisac w panelu od nowa.
SETTINGS_ENCRYPTION_KEY=
SETTINGS_KEY_FILE=settings.key
