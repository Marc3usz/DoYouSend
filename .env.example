# Skopiuj do .env i uzupelnij. .env NIGDY nie trafia do repo.
# W .env sa tylko wartosci potrzebne do startu. Operatorow e-mail i SMS, klucze API, cene SMS
# i import z Notion ustawia sie w Panelu administratora -> Ustawienia wysylki (ADR-0018).
# Na etapie budowy uzywamy wylacznie kont testowych/sandbox.

# --- Aplikacja ---
APP_ENV=development
API_PORT=8080
# Adres API widziany przez frontend: proxy /api w `make dev-web` i zapytania po stronie serwera.
# Zmieniasz API_PORT - zmien port takze tutaj.
PUBLIC_API_URL=http://localhost:8080

# --- Baza danych (make up) ---
DATABASE_URL=postgres://doyousend:doyousend@localhost:5432/doyousend?sslmode=disable
# Testy integracyjne (make test-integration czyta te zmienna z tego pliku). Kazdy test tworzy
# i usuwa wlasny schemat, wiec moze to byc ta sama baza co DATABASE_URL.
TEST_DATABASE_URL=postgres://doyousend:doyousend@localhost:5432/doyousend?sslmode=disable

# --- Logowanie (ADR-0010) ---
# Sesje po stronie serwera w tabeli sessions; cookie dys_session (HttpOnly, SameSite=Lax).
# Secure (tylko HTTPS) jest domyslnie wlaczone poza APP_ENV=development.
SESSION_COOKIE_SECURE=false
# Haslo pierwszego administratora dla `make create-admin` (min. 12 znakow). Mozna zostawic
# puste - wtedy komenda zapyta o nie. Nie commituj prawdziwego hasla.
ADMIN_PASSWORD=

# --- Bezpiecznik wysylki ---
# true = system nie wysyla nic na zewnatrz, tylko rejestruje. Panel moze to zmienic
# (z potwierdzeniem), a wartosc z panelu wygrywa z tym plikiem.
DRY_RUN=true
# true = panel administratora nie moze wylaczyc DRY_RUN (srodowiska demo i testowe). ADR-0018.
DRY_RUN_LOCK=false

# --- Klucz do sekretow z panelu (ADR-0018) ---
# Klucze API wpisane w panelu sa szyfrowane w bazie (AES-256-GCM) tym kluczem: 32 losowe bajty
# w base64, np. `openssl rand -base64 32`. Gdy pusty, API tworzy plik SETTINGS_KEY_FILE
# (domyslnie backend/settings.key) przy pierwszym starcie.
# Zrob kopie klucza/pliku osobno od bazy: bez niego klucze API trzeba wpisac w panelu od nowa.
SETTINGS_ENCRYPTION_KEY=
SETTINGS_KEY_FILE=settings.key

# =====================================================================================
# Opcjonalnie: wartosci domyslne dla panelu (Panel administratora -> Ustawienia wysylki)
# =====================================================================================
# Wszystko ponizej ustawia sie w panelu. Odkomentowana zmienna dziala jako wartosc zapasowa,
# gdy panel nie ma wlasnej: kolejnosc to panel, potem .env, potem domyslna w kodzie
# (backend/internal/settings/defs.go). Domyslnie: EMAIL_PROVIDER=mailpit, SMS_PROVIDER=fake.
# Wyjatek: `make import-notion` (CLI) czyta NOTION_* wylacznie z tego pliku.

# --- Dostawca e-mail ---
# Lokalnie: Mailpit (make up), nic nie wychodzi na zewnatrz.
# Produkcyjnie: SendGrid Web API v3 (EMAIL_PROVIDER=sendgrid; ADR-0008, ADR-0014).
# EMAIL_PROVIDER=mailpit
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM="Szkola Testowa <no-reply@example.test>"
# Adres odpowiedzi dla wysylek ze wspolnego adresu (puste: odpowiedzi ida na EMAIL_FROM). ADR-0021.
# EMAIL_REPLY_TO=
# Domyslny nadawca w kreatorze: own (adres wysylajacego, gdy operator go przyjmie) albo shared.
# EMAIL_SENDER_DEFAULT=own
# SENDGRID_API_KEY=
# SENDGRID_WEBHOOK_PUBLIC_KEY=
# SENDGRID_SANDBOX=false
# Region danych SendGrid: global (api.sendgrid.com) albo eu (api.eu.sendgrid.com). ADR-0014.
# SENDGRID_REGION=global
# Adres szkoly pokazywany w e-mailu weryfikujacym nadawce (ADR-0016).
# SENDGRID_SENDER_ADDRESS="ul. Przykladowa 1"
# SENDGRID_SENDER_CITY=Testowo
# SENDGRID_SENDER_ZIP=00-000
# SENDGRID_SENDER_COUNTRY=Polska

# --- Bramka SMS ---
# Lokalnie: provider "fake" zapisuje SMS-y do logu/bazy zamiast wysylac.
# Produkcyjnie: provider "smsapi" (REST API SMSAPI, ADR-0003).
# SMS_PROVIDER=fake
# SMS_API_KEY=
# SMS_SENDER_NAME=SZKOLA-TEST
# SMS_TEST_MODE=false
# SMS_PRICE_PER_PART_PLN=0.08
# Limit czesci jednego SMS-a w SMSAPI (max_parts); 0 = ustawienie konta.
# SMS_MAX_PARTS=0
# Token callbacku DLR z SMSAPI (/providers/sms/dlr?token=... albo /providers/sms/dlr/{token}).
# Token w URL moze trafic do access logow proxy - rotuj go po wycieku logow.
# SMSAPI_DLR_TOKEN=

# --- Import odbiorcow z Notion (ADR-0017) ---
# Sekret integracji wewnetrznej (Notion > Settings > Connections > Develop or manage integrations).
# NOTION_TOKEN=
# ID albo caly URL bazy. Gdy baza ma kilka zrodel danych, podaj NOTION_DATA_SOURCE_ID.
# NOTION_DATABASE_ID=
# NOTION_DATA_SOURCE_ID=
# "Kolumna w Notion=kolumna importu", np. "Name=first_name,Surname=last_name".
# Puste = kolumny nazwane jak w szablonie CSV (Imie, Nazwisko, E-mail, Telefon, Typ, Klasa).
# NOTION_PROPERTY_MAP=
